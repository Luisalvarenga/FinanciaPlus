# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by git: never commit real credentials.
#
# It is read by docker-compose.yml (local MySQL) and by the backend
# when it runs on your machine. In production these values are set
# as environment variables on the hosting platform instead.

# Local MySQL container
MYSQL_ROOT_PASSWORD=change-me

# Database credentials used by the backend
DB_USERNAME=financiaplus
DB_PASSWORD=change-me

# Signing key for the JWT tokens: at least 32 characters, random.
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters

# Password shared by the demo accounts created on first start.
SEED_DEFAULT_PASSWORD=change-me
